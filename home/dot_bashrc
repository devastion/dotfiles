#!/usr/bin/env bash

[[ $- != *i* ]] && return

HISTCONTROL='ignoreboth:erasedups'
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
[[ -d "${HISTFILE%/*}" ]] || mkdir -p "${HISTFILE%/*}"
HISTSIZE=10000
HISTFILESIZE=20000
HISTIGNORE='ls:ll:cd:cd -:pwd:exit:clear:history:bg:fg'
HISTTIMEFORMAT='%F %T '

PROMPT_COMMAND='history -a; history -n'

shopt -s histappend
shopt -s cmdhist
shopt -s checkwinsize
shopt -s nocaseglob
shopt -s cdspell
shopt -s no_empty_cmd_completion

if ((BASH_VERSINFO[0] >= 4)); then
  shopt -s globstar
  shopt -s autocd
  shopt -s dirspell
fi

set -o noclobber

[[ -t 0 ]] && stty -ixon

PS1='\u@\h:\w\$ '
