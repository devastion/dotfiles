--popup 'center,80%,border-native'
--height '60%'
--layout 'reverse'
--border
--info 'inline'
--cycle
--scroll-off '3'
--marker '+'
--margin '0,1,0,1'

--color 'bg+:#292E42,border:#27a1b9,fg:#c0caf5,gutter:#16161e'

--bind 'ctrl-a:beginning-of-line'
--bind 'ctrl-e:end-of-line'

--bind 'ctrl-b:backward-char'
--bind 'ctrl-f:forward-char'

--bind 'alt-b:backward-word'
--bind 'alt-f:forward-word'

--bind 'ctrl-w:backward-kill-word'
--bind 'alt-d:kill-word'

--bind 'ctrl-n:down'
--bind 'ctrl-p:up'
--bind 'ctrl-j:down'
--bind 'ctrl-k:up'

--bind 'ctrl-up:previous-history'
--bind 'ctrl-down:next-history'

--bind 'ctrl-d:half-page-down'
--bind 'ctrl-u:half-page-up'

--bind 'tab:toggle'

--bind 'ctrl-l:clear-query'
--bind 'ctrl-x:jump'

--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)'
--bind 'alt-e:execute(nvim {+})'

--bind 'alt-j:preview-down'
--bind 'alt-k:preview-up'

--bind '?:toggle-preview'

--bind 'f1:toggle-preview'
--bind 'f2:toggle-preview-wrap'

--preview-window 'hidden,right:60%,border-left'
--preview '$XDG_CONFIG_HOME/fzf/preview.sh {}'
