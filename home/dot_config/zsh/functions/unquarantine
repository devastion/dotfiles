#!/usr/bin/env zsh

unquarantine() {
  emulate -L zsh

  [[ $OSTYPE == darwin* ]] ||
    {
      print -u2 'unquarantine: only supported on macOS'
      return 1
    }

  (($#)) ||
    {
      print -u2 'Usage: unquarantine <file_or_dir> [file_or_dir...]'
      return 1
    }

  (($+commands[xattr])) ||
    {
      print -u2 'unquarantine: xattr not found'
      return 127
    }

  local -a attrs=(
    'com.apple.metadata:kMDItemDownloadedDate'
    'com.apple.metadata:kMDItemWhereFroms'
    'com.apple.quarantine'
  )

  local target attr
  local -i failed=0

  for target in "$@"; do
    if [[ ! -e $target ]]; then
      print -u2 "unquarantine: path not found: $target"
      failed=1
      continue
    fi

    for attr in "${attrs[@]}"; do
      command xattr -r -d "$attr" -- "$target" 2> /dev/null
    done

    print -r -- "Cleared quarantine attributes from: $target"
  done

  return failed
}
