#!/usr/bin/env zsh

pastedir() {
  emulate -L zsh

  (("$#" > 1)) && {
    print -u2 'Usage: pastedir [dir]'
    return 1
  }

  local dest="${1:-$PWD}"

  [[ -d $dest ]] || {
    print -u2 -- "pastedir: not a directory: $dest"
    return 1
  }

  pbpaste |
    command base64 -d |
    command tar -xzf - -C "$dest"

  local -a ps=($pipestatus)

  if ((ps[1] == 0 && ps[2] == 0 && ps[3] == 0)); then
    print -r -- "Extracted archive from clipboard into ${dest}"
    return 0
  fi

  print -u2 -- 'pastedir: failed to decode or extract clipboard archive'
  return 1
}
