[alias]
  st = status -sb
  co = checkout
  br = branch
  ci = commit
  df = diff
  dc = diff --cached
  cp = cherry-pick
  cpbr = "!printf '%s' \"$(git branch --show-current)\" | pbcopy"

  lg = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  lga = log --graph --all --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  last = log -1 HEAD --stat
  thismonth = "!f() { git log --author=\"$(git config user.name)\" --since=\"$(date +%Y-%m-01)\" --reverse --pretty=format:'%cd  %h  %s' --date=short; }; f"
  lastmonth = "!f() { s=$(date -v-1m +%Y-%m-01 2>/dev/null || date -d '1 month ago' +%Y-%m-01); git log --author=\"$(git config user.name)\" --since=\"$s\" --until=\"$(date +%Y-%m-01)\" --reverse --pretty=format:'%cd  %h  %s' --date=short; }; f"
  alastweek = log --since='last sunday' --reverse --pretty=format:'%cd  %h  %s' --date=short
  lastweek = "!f() { git log --author=\"$(git config user.name)\" --since='last sunday' --reverse --pretty=format:'%cd  %h  %s' --date=short; }; f"

  alias = "!git config --get-regexp 'alias.*' | sed 's/^alias\\.//' | sed 's/[ ]/ = /' | sort"
  amend = commit --amend --no-edit
  backup = "!git tag backup-$(date +%s)"
  conflicts = diff --name-only --diff-filter=U
  contains = branch -a --contains
  discard = checkout --
  fixup = "!git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | awk '{print $1}' | xargs -o git commit --fixup"
  please = push --force-with-lease
  recent = for-each-ref --sort=-committerdate --format='%(committerdate:short) %(refname:short)' refs/heads/
  retag = "!f() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; f"
  tags = tag -l
  undo = reset --soft HEAD~1
  undo-push = "!f() { git push -f origin \"HEAD^:${1:?branch required}\"; }; f"
  stash-all = stash push --no-keep-index --include-untracked
  unstage = restore --staged --
  wdiff = diff --word-diff=color
  wip = commit -am "wip"
  root = rev-parse --show-toplevel
