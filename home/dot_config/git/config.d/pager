[core]
  pager = "delta"

[pager]
  diff = "delta"
  log = "delta"
  reflog = "delta"
  show = "delta"
  blame = "delta"

[interactive]
  diffFilter = "delta --color-only"

[delta]
  features = "tokyonight-night"
  navigate = true
  line-numbers = true
  side-by-side = true
  keep-plus-minus-markers = false
  syntax-theme = "tokyonight"
  true-color = "auto"
  width = "variable"
  file-added-label = [+]
  file-copied-label = [*]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [>]

[delta "tokyonight-night"]
  minus-style=syntax "#4a272f"
  minus-non-emph-style=syntax "#4a272f"
  minus-emph-style=syntax "#713137"
  minus-empty-line-marker-style=syntax "#4a272f"
  line-numbers-minus-style="#914c54" bold
  plus-style=syntax "#243e4a"
  plus-non-emph-style=syntax "#243e4a"
  plus-emph-style=syntax "#2c5a66"
  plus-empty-line-marker-style=syntax "#243e4a"
  line-numbers-plus-style="#449dab" bold
  line-numbers-zero-style="#3b4261"
  whitespace-error-style = "#914c54" reverse
  line-numbers-left-style="#1f2335"
  line-numbers-right-style="#1f2335"
; vim:ft=gitconfig
